</section>

<div class="small-note">
  ✦ これは実際のWeb用SVGを表示しているよ。
  まだキャラクターの形は試作段階。
  気になるところを教えてもらったら、ここを修正していくよ。
</div>
</main>

<script>
const stage=document.getElementById('stage');
const caption=document.getElementById('caption');

const captions={
  flat:'床にぺしょっと寝そべるふたり・試作1号',
  sit:'並んで座るふたり・試作1号',
  close:'寄り添うふたり・試作1号'
};

document.querySelectorAll('.pose').forEach(button=>{
  button.addEventListener('click',()=>{
    const pose=button.dataset.pose;

    document.querySelectorAll('.pose').forEach(b=>{
      b.classList.toggle('active',b===button);
    });

    document.querySelectorAll('.scene').forEach(svg=>{
      svg.classList.toggle('active',svg.id===pose);
    });

    caption.textContent=captions[pose];
  });
});

document.querySelectorAll('.color').forEach(button=>{
  button.addEventListener('click',()=>{
    const color=button.dataset.color;

    document.querySelectorAll('.color').forEach(b=>{
      b.classList.toggle('active',b===button);
    });

    stage.className='stage '+color;
  });
});
</script>
</body>
</html>
